# Same Postgres as the server; pg-boss keeps its job queue there (schema "pgboss").
# Use the Supabase Session pooler (port 5432), not the Transaction pooler.
DATABASE_URL=

# Same PayPal sandbox app as the server (the deadline job voids authorizations).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
