# The worker normally runs inside the API (RUN_WORKER=true on Render). Don't run this
# separate process against the shared database while the deployed one is on.

# Same Postgres as the server; pg-boss keeps its job queue there (schema "pgboss").
# Use the Supabase Session pooler (port 5432), not the Transaction pooler.
DATABASE_URL=

# Same PayPal sandbox app as the server (the deadline job voids authorizations).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Same key as the server (the dispute agent runs here). Without it, disputes go straight to an admin.
ANTHROPIC_API_KEY=
# Optional, same as the server: lower the shared Claude budget, never raise it.
CLAUDE_BUDGET_CALLS_PER_DAY=
CLAUDE_BUDGET_CALLS_PER_USER_PER_DAY=
